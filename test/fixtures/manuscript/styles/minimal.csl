<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-US">
  <info>
    <title>Minimal author-year (test fixture)</title>
    <id>https://561.group/csl/minimal-author-year-test-fixture</id>
    <updated>2026-10-24T00:00:00+00:00</updated>
    <rights license="https://creativecommons.org/publicdomain/zero/1.0/">Public domain test fixture.</rights>
  </info>
  <macro name="author">
    <names variable="author">
      <name form="short" and="text"/>
    </names>
  </macro>
  <macro name="author-long">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="."/>
    </names>
  </macro>
  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=" ">
        <text macro="author"/>
        <date variable="issued"><date-part name="year"/></date>
      </group>
      <text variable="locator" prefix=", p. "/>
    </layout>
  </citation>
  <bibliography>
    <layout suffix=".">
      <group delimiter=" ">
        <text macro="author-long"/>
        <date variable="issued" prefix="(" suffix=")"><date-part name="year"/></date>
        <text variable="title" font-style="italic"/>
      </group>
    </layout>
  </bibliography>
</style>
